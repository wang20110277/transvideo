{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path aliases（paths 相对 tsconfig 所在目录解析，无需已弃用的 baseUrl） */
    "paths": {
      "@/*": ["./src/*"],
      "@editor/*": ["./src/editor/*"],
      "@opencut/ai-core": ["./src/packages/ai-core/index.ts"],
      "@opencut/ai-core/*": ["./src/packages/ai-core/*"],
      "@smartsub/bridge": ["./electron/services/smartsub/bridge/index.d.ts"],
      // 渲染层 type-only 导入经 @smartsub/* 直达移植树文件(树本体仍由
      // electron/services/smartsub/tsconfig.json 单独编译;exact 条目
      // @smartsub/bridge 优先级高于通配,类型门面不受影响)
      "@smartsub/*": ["./electron/services/smartsub/*"]
    },

    /* Linting */
    "strict": true,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "electron"],
  "exclude": ["node_modules", "electron/services/smartsub"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
